APP_NAME="Root Keeper"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://genealog.kostecki.dev

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=root_keeper
DB_USERNAME=keeper
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=genealog.kostecki.dev
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_HOST is required by deploy.sh's preflight check (scripts/deploy.sh);
# the deploy aborts if it is empty.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@kostecki.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# BACKUP_ARCHIVE_PASSWORD and BACKUP_NOTIFICATION_MAIL are required by
# deploy.sh's preflight check; the deploy aborts if either is empty.
# Store BACKUP_ARCHIVE_PASSWORD outside this VPS too (e.g. a password
# manager) — it is the only way to decrypt backups if this host is lost.
# BACKUP_OFFSITE_ENABLED must stay false until offsite storage is ready;
# deploy.sh's preflight check aborts the deploy if it is truthy.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_MAIL=admin@kostecki.dev
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_KEY=
BACKUP_OFFSITE_SECRET=
BACKUP_OFFSITE_REGION=eu-central
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_USE_PATH_STYLE_ENDPOINT=true
BACKUP_HOST_DIR=/storage/root-keeper-backups

VITE_APP_NAME="${APP_NAME}"

WWWUSER=1000
WWWGROUP=1000
